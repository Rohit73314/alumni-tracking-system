{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,

    "types": [
      "@cloudflare/workers-types",   // ← fixes most wrangler type resolution issues
      "vite/client"
    ],

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/worker"
  ]
}